{
  "name": "lottery-draw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:mcp": "npm run build:mcp-app && tsc --noEmit -p tsconfig.mcp.json",
    "build:mcp-app": "tsc --noEmit -p tsconfig.mcp-app.json && vite build --config vite.mcp-app.config.ts && node tools/remote-mcp/generate-mcp-app-resource.mjs",
    "build:web": "tsc --noEmit -p tsconfig.web.json && vite build",
    "dev:mcp": "npm run build:mcp-app && tsx tools/remote-mcp/local-mcp-server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:core": "vitest run --config vitest.core.config.ts",
    "test:mcp": "vitest run --config vitest.mcp.config.ts",
    "test:mcp-app": "vitest run --config vitest.mcp-app.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:watch": "vitest",
    "inspect:mcp:list": "mcp-inspector --cli http://127.0.0.1:3000/mcp --transport http --method tools/list --format json",
    "inspect:mcp:call": "mcp-inspector --cli http://127.0.0.1:3000/mcp --transport http --method tools/call --tool-name draw_roulette --tool-args-json '{\"rawInput\":\"1~3, 민지*2\",\"drawCount\":3}' --format json",
    "verify:boundaries": "node tools/remote-mcp/verify-boundaries.mjs",
    "verify": "npm run test:core && npm run test:web && npm run test:mcp-app && npm run build:web && npm run build:mcp && npm run test:mcp && npm run verify:boundaries"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/server": "2.0.0",
    "html-to-image": "^1.11.13",
    "mcp-handler": "2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mcp-ui/server": "6.1.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/inspector": "2.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "tsx": "4.23.6",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "^4.1.10"
  }
}
